classDiagram
    %% PawPal+ class design
    %% Keep this file updated so it matches your final implementation.

    class Owner {
        +str name
        +int available_minutes
        +list~str~ preferences
        +list~Pet~ pets
        +add_pet(pet: Pet) None
        +get_pet(name: str) Pet
    }

    class Pet {
        +str name
        +str species
        +int age
        +list~Task~ tasks
        +add_task(task: Task) None
        +remove_task(title: str) None
        +get_tasks() list~Task~
    }

    class Task {
        +str title
        +int duration_minutes
        +str priority
        +bool is_recurring
        +str preferred_time
        +priority_score() int
        +__repr__() str
    }

    class Scheduler {
        +Owner owner
        +int start_hour
        +build_schedule(pet: Pet, available_minutes: int) Schedule
        -sort_tasks(tasks: list~Task~) list~Task~
        -fits_in_time(task: Task, remaining: int) bool
    }

    class Schedule {
        +date day
        +list~ScheduledTask~ entries
        +int total_minutes
        +add_entry(entry: ScheduledTask) None
        +explain() str
        +to_display_rows() list~dict~
    }

    class ScheduledTask {
        +Task task
        +time start_time
        +time end_time
        +str reason
    }

    Owner "1" o-- "*" Pet : owns
    Pet "1" o-- "*" Task : has
    Scheduler ..> Owner : reads preferences
    Scheduler ..> Pet : schedules tasks for
    Scheduler --> Schedule : produces
    Schedule "1" *-- "*" ScheduledTask : contains
    ScheduledTask --> Task : wraps
